{
    "wireplumber": {
        "format": "{icon} {volume}%",
        "format-icons": [
            "󰕿",
            "󰖀",
            "󰖀",
            "󰕾",
            "󰕾"
        ],
        "tooltip": false,
        "max-volume": 100,
        "scroll-step": 1
    },
    "wireplumber#source": {
        "node-type": "Audio/Sink",
        "format": "{node_name}",
        "tooltip": false
    }
}
